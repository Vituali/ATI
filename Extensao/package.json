{
  "name": "ati-auxiliar-de-atendimentos",
  "displayName": "ATI - Auxiliar de Atendimentos",
  "version": "2.2.0.7",
  "author": "Vituali",
  "description": "Extensão para auxiliar atendentes do suporte ATI Internet no ChatMix",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "atendimento",
    "chatmix",
    "sgp",
    "ati"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite build --mode development --watch",
    "dev:prod": "vite build --mode dev_prod --watch",
    "clean": "node -e \"const {rmSync,existsSync}=require('fs');if(existsSync('build'))rmSync('build',{recursive:true,force:true});\"",
    "build": "npm run clean && tsc && vite build",
    "fmt": "prettier --write '**/*.{tsx,ts,json,css,scss,md}'",
    "format": "prettier --write \"**/*.{tsx,ts,json,css,scss,md}\"",
    "lint": "eslint .",
    "zip": "npm run build && node src/zip.js",
    "release": "npm run build && node src/zip.js && node src/update-firebase-version.js"
  },
  "dependencies": {
    "firebase": "12.15.0",
    "lucide-react": "^1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.0",
    "@eslint/js": "10.0.1",
    "@types/chrome": "^0.0.332",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.5.0",
    "globals": "17.6.0",
    "gulp": "5.0.0",
    "gulp-zip": "6.0.0",
    "prettier": "3.8.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.61.1",
    "vite": "6.4.3"
  }
}

{
  "name": "ati-monorepo",
  "private": true,
  "version": "2.2.0",
  "description": "Monorepo orquestrador do ecossistema ATI (Extensão do Chrome e Painel Web)",
  "scripts": {
    "dev:extension": "npm run dev --prefix \"Extensão\"",
    "dev:extension:prod": "npm run dev:prod --prefix \"Extensão\"",
    "dev:site": "npm run dev --prefix \"Site\"",
    "build:extension": "npm run build --prefix \"Extensão\"",
    "build:site": "npm run build --prefix \"Site\"",
    "zip:extension": "npm run zip --prefix \"Extensão\"",
    "release:extension": "npm run release --prefix \"Extensão\"",
    "lint:site": "npm run lint --prefix \"Site\"",
    "install:all": "npm install --prefix \"Extensão\" && npm install --prefix \"Site\"",
    "deploy": "npm run deploy --prefix \"Site\"",
    "env:dev": "node switch-env.cjs dev",
    "env:prod": "node switch-env.cjs prod",
    "env:dev_prod": "node switch-env.cjs dev_prod",
    "generate-icons": "npm run generate-icons --prefix \"Site\""
  },
  "author": "Vituali",
  "license": "MIT"
}
